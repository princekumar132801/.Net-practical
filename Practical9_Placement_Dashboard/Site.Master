<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="Practical9.SiteMaster" %>
<!DOCTYPE html>
<html>
<head runat="server">
    <title><%: Page.Title %> - Placement Portal</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        body {
            font-family: Arial;
            margin: 0;
            background: #f4f6f9;
            color: #263746;
        }
        .header {
            background: #263746;
            color: white;
            padding: 18px 5%;
            font-size: 22px;
            font-weight: bold;
        }
        .container {
            max-width: 1100px;
            margin: 30px auto;
            background: white;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 3px 15px rgba(0,0,0,.08);
        }
        .footer {
            text-align: center;
            padding: 20px;
            border-top: 1px solid #ddd;
        }
        table {
            border-collapse: collapse;
        }
        th, td {
            padding: 9px;
            border: 1px solid #ddd;
        }
        a {
            color: #0d6efd;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <div class="header">
            Practical9 | Placement Portal
        </div>
        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <div class="footer">
            &copy; <%: DateTime.Now.Year %> - Placement Portal
        </div>
    </form>
</body>
</html>
