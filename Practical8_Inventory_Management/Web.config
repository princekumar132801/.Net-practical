<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="InventoryConnection"
         connectionString="Data Source=localhost;Initial Catalog=InventoryDB;Integrated Security=True;TrustServerCertificate=True;Pooling=True;Min Pool Size=3;Max Pool Size=100;Connection Timeout=10;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
