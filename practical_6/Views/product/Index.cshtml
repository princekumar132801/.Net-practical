@model List<practical_6.Models.Product>

<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>

    <style>
        body {
            font-family: Arial;
            margin: 40px;
        }

        h1 {
            margin-bottom: 20px;
        }

        table {
            width: 80%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid black;
            padding: 10px;
        }

        th {
            background-color: #eeeeee;
        }
    </style>
</head>

<body>

    <h1>Product Catalog</h1>

    <table>
        <tr>
            <th>Product ID</th>
            <th>Product Name</th>
            <th>Price</th>
            <th>Quantity</th>
        </tr>

        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductId</td>
                <td>@product.ProductName</td>
                <td>₹ @product.Price</td>
                <td>@product.Quantity</td>
            </tr>
        }
    </table>

</body>
</html>